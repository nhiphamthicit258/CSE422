
@model IEnumerable<DeviceManagement.Models.Device>

@{
    ViewData["Title"] = "Devices";
}

<h1>Devices</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Search by name or code" />
        </div>

        <div class="col-md-3">
            <select name="status"
                    asp-items="ViewBag.Status"
                    class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="categoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">
                <option value="">All Categories</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Search / Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary mt-1">
                Reset
            </a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Device</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Device Name</th>
            <th>Device Code</th>
            <th>Category</th>
            <th>Status</th>
            <th>Entry Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var device in Model)
    {
        <tr>
            <td>@device.Name</td>
            <td>@device.Code</td>
            <td>@device.DeviceCategory?.Name</td>
            <td>@Html.DisplayFor(_ => device.Status)</td>
            <td>@device.EntryDate.ToString("dd/MM/yyyy")</td>
            <td>
                <a asp-action="Edit"
                   asp-route-id="@device.Id"
                   class="btn btn-warning">Edit</a>

                <form asp-action="Delete"
                      asp-route-id="@device.Id"
                      method="post"
                      style="display:inline"
                      onsubmit="return confirm('Are you sure you want to delete this device?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
</tbody>
</table>
